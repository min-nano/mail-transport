# deploy/*.sh が読み込む設定。config.env にコピーして書き換える。
PROJECT_ID="my-gcp-project"
REGION="asia-northeast1"

SERVICE_NAME="mail-transport"
JOB_NAME="mail-transport-sync"

# 実行用サービスアカウント (Cloud Run 本体)
RUNTIME_SA_NAME="mail-transport-run"
# 呼び出し用サービスアカウント (Cloud Scheduler)
INVOKER_SA_NAME="mail-transport-invoker"

# iCloud
ICLOUD_USERNAME="you@icloud.com"

# 同期間隔 (cron 形式)。"* * * * *" で毎分。
SCHEDULE="* * * * *"
SCHEDULE_TZ="Etc/UTC"

# Cloud Run リソース。無料枠に収めるため小さめに固定する。
CPU="1"
MEMORY="512Mi"
# 同時実行しても意味がないので 1 に固定 (Firestore ロックとの二重防御)
CONCURRENCY="1"
MAX_INSTANCES="1"
# 常時起動インスタンスは無料枠を超えるので 0 のままにすること
MIN_INSTANCES="0"
REQUEST_TIMEOUT="300"

# アプリ設定
MAX_MESSAGES_PER_RUN="40"
RUN_BUDGET_SECONDS="240"
INITIAL_IMPORT="none"   # none: 稼働開始以降のメールのみ / all: 既存メールも全部
