# deploy/*/*.sh が読み込む設定。deploy/config.env にコピーして書き換える。

# ===== 共通 =====
PROJECT_ID="my-gcp-project"

# iCloud のメールアドレス
ICLOUD_USERNAME="you@icloud.com"

# 実行用サービスアカウント (VM / Cloud Run にアタッチする)
RUNTIME_SA_NAME="mail-transport-run"

# none: 稼働開始以降に届いたメールのみ転送 / all: 既存メールもすべて転送
INITIAL_IMPORT="none"


# ===== 構成 A: GCE e2-micro 常時起動 (推奨) =====
# IMAP IDLE で新着を待ち受けるので転送は数秒。Always Free の対象。
#
# 無料枠の条件 (2026-09 時点の公式情報):
#   - マシンタイプは e2-micro のみ
#   - リージョンは us-west1 / us-central1 / us-east1 のみ
#   - 標準永続ディスク (pd-standard) 30GB まで
#   - 北米からの下り (外向き) 通信 1GB/月まで (中国・オーストラリア宛を除く)
VM_NAME="mail-transport"
VM_ZONE="us-west1-b"
VM_MACHINE_TYPE="e2-micro"     # 変更すると無料枠から外れる
VM_DISK_SIZE_GB="30"           # 無料枠の上限
VM_DISK_TYPE="pd-standard"     # コンソール既定の pd-balanced は無料枠の対象外
VM_IMAGE_FAMILY="debian-12"
VM_IMAGE_PROJECT="debian-cloud"


# ===== 構成 B: Cloud Run + Cloud Scheduler (代替) =====
# 毎分ポーリング。Cloud Run と Cloud Scheduler の無料枠を消費する。
REGION="asia-northeast1"
SERVICE_NAME="mail-transport"
JOB_NAME="mail-transport-sync"
INVOKER_SA_NAME="mail-transport-invoker"
SCHEDULE="* * * * *"
SCHEDULE_TZ="Etc/UTC"
CPU="1"
MEMORY="512Mi"
CONCURRENCY="1"
MAX_INSTANCES="1"
MIN_INSTANCES="0"              # 1 以上にすると無料枠を大きく超える
REQUEST_TIMEOUT="300"
MAX_MESSAGES_PER_RUN="40"
RUN_BUDGET_SECONDS="240"
