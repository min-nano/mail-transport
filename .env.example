# ローカル実行 (python -m mailtransport.cli) 用のサンプル。
# .env にコピーして書き換える。.env は .gitignore 済み。

# --- iCloud (IMAP) ---
ICLOUD_USERNAME=you@icloud.com
# Apple ID のアプリ用パスワード。通常のパスワードでは接続できない。
# https://account.apple.com/account/manage で発行する。
ICLOUD_APP_PASSWORD=abcd-efgh-ijkl-mnop
ICLOUD_IMAP_HOST=imap.mail.me.com
ICLOUD_IMAP_PORT=993

# --- Gmail (API) ---
# tools/get_gmail_refresh_token.py の出力を 1 行の JSON にして貼る。
GMAIL_OAUTH_JSON={"client_id":"...","client_secret":"...","refresh_token":"..."}
GMAIL_USER_ID=me

# --- GCP ---
# Secret Manager のシークレット名を短縮形で指定するときに使う
GOOGLE_CLOUD_PROJECT=my-gcp-project

# --- 転送の挙動 ---
# 転送経路。source は IMAP のメールボックス名か特殊用途フラグ (\Junk など)。
# labels は Gmail のラベル ID (INBOX / SPAM / STARRED / UNREAD / ユーザーラベル ID)。
# trash は省略可。書くと TRASH_AFTER_FORWARD をその経路だけ上書きする。
# 既定は受信トレイのみ。迷惑メールは転送しない。
ROUTES=[{"source":"INBOX","labels":["INBOX"]}]
# 迷惑メールも Gmail に持ち込みたい場合は、次の行のように \Junk を足す。
# Gmail の SPAM も 30 日で自動削除されるので、iCloud の原本は残す ("trash":false)。
# ROUTES=[{"source":"INBOX","labels":["INBOX"]},{"source":"\\Junk","labels":["SPAM"],"trash":false}]

# none: 稼働開始以降に届いたメールのみ転送 (既定)
# all : iCloud に残っている既存メールもすべて転送
INITIAL_IMPORT=none

# 転送が済んだメールを iCloud のゴミ箱へ移す (既定: true)。iCloud の容量を
# 空けるための後始末。false にすると iCloud 側は読み取り専用のまま触らない。
TRASH_AFTER_FORWARD=true
# ゴミ箱の場所。既定は RFC 6154 の特殊用途フラグ \Trash (iCloud では
# 「Deleted Messages」)。iCloud はゴミ箱を 30 日で空にするため、原本を長く
# 残したいときは自動削除されないフォルダ名を書く。
TRASH_MAILBOX=\Trash

# ゴミ箱へ移す前に、Gmail 側にメールが入ったことを読み戻して確認する。
#   auto  : 確認できるなら確認する (既定)。トークンに gmail.metadata が無い
#           場合は 1 度警告して従来どおり移す
#   true  : 必ず確認する。確認できないメールは iCloud に残す
#   false : 確認しない
VERIFY_BEFORE_TRASH=auto

# INITIAL_IMPORT=all の初回取り込みで、稼働開始前から iCloud にあった
# メールもゴミ箱へ移すか (既定: false)。false のままなら転送だけ行い、
# Gmail 側の件数を確認してから手で整理できる。
TRASH_EXISTING_ON_INITIAL_IMPORT=false

MAX_MESSAGES_PER_RUN=40
RUN_BUDGET_SECONDS=240
MAX_MESSAGE_BYTES=36700160
# 重複排除レコードの保持日数。0 で無期限 (既定)。期限を切ると、利用者が
# 受信トレイへ戻したメールが再転送され、再びゴミ箱へ移されてしまう。
SEEN_RETENTION_DAYS=0
LOG_LEVEL=INFO

# true にすると Gmail への挿入も状態保存も行わない (動作確認用)
DRY_RUN=false

# --- 状態の保存先 ---
# sqlite: ローカルファイル (既定)
# memory: プロセス内のみ (テスト用)
STATE_BACKEND=sqlite
STATE_DB_PATH=./state.db

# --- 常駐モード (--daemon) ---
# IMAP IDLE で新着を待ち受ける。false にすると POLL_INTERVAL_SECONDS の定期実行になる。
IDLE_ENABLED=true
# IDLE を張り直す間隔。RFC 2177 の推奨により 29 分未満にすること。
IDLE_REFRESH_SECONDS=1500
# IDLE が使えないサーバー向けのフォールバック間隔
POLL_INTERVAL_SECONDS=60
# IDLE の取りこぼしに備えた定期同期の間隔
SAFETY_SYNC_SECONDS=300
# 連続到着をまとめて処理するための待ち時間
DEBOUNCE_SECONDS=2
# 接続断からの再接続の最大待ち時間
RECONNECT_BACKOFF_MAX_SECONDS=300
